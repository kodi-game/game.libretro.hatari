msgctxt "#30062"
msgid "Loads SYSTEM\\hatari\\hatari.cfg on content start.  Warning.  Overrides everything except for selected TOS image."
msgstr "Při spuštění obsahu načte SYSTEM\\hatari\\hatari.cfg. Upozornění: přepíše vše kromě vybraného obrazu TOS."

msgctxt "#30063"
msgid "System"
msgstr "Systém"

msgctxt "#30064"
msgid "Set Machine Type.  Ramsize.  TOS Used.  Enable Fast Boot."
msgstr "Nastavení typu počítače, velikosti RAM, použitého TOS a rychlého spuštění."

msgctxt "#30065"
msgid "Pick emulated machine.  ST, STE, TT or Falcon (Needs Restart)"
msgstr "Vyberte emulovaný počítač. ST, STE, TT nebo Falcon (vyžaduje restart)"

msgctxt "#30066"
msgid "ST (1.02, 2.06)"
msgstr "ST (1.02, 2.06)"

msgctxt "#30067"
msgid "STE (1.62, 2.06)"
msgstr "STE (1.62, 2.06)"

msgctxt "#30068"
msgid "TT (3.01, 3.05, 3.06)"
msgstr "TT (3.01, 3.05, 3.06)"

msgctxt "#30069"
msgid "Falcon (4.00 and up)"
msgstr "Falcon (4.00 a novější)"

msgctxt "#30070"
msgid "Set amount of emulated ram.  (Needs Restart)"
msgstr "Nastavte velikost emulované RAM (vyžaduje restart)."

msgctxt "#30071"
msgid "512 KB"
msgstr "512 KB"

msgctxt "#30072"
msgid "1 MB"
msgstr "1 MB"

msgctxt "#30073"
msgid "2 MB"
msgstr "2 MB"

msgctxt "#30074"
msgid "4 MB"
msgstr "4 MB"

msgctxt "#30075"
msgid "8 MB"
msgstr "8 MB"

msgctxt "#30076"
msgid "14 MB"
msgstr "14 MB"

msgctxt "#30077"
msgid ""
"Select from list.\n"
"\n"
"Place TOS images in system\\hatari\\tos\\ folder.\n"
"Defaults to tos.img in SYSTEM folder"
msgstr ""
"Vyberte ze seznamu.\n"
"\n"
"Obrazy TOS umístěte do složky system\\hatari\\tos\\.\n"
"Výchozí je tos.img ve složce SYSTEM."

msgctxt "#30078"
msgid "system\\tos.img (not found)"
msgstr "system\\tos.img (nenalezeno)"

msgctxt "#30079"
msgid "Enable/Disable fast boot TOS patch."
msgstr "Povolí/zakáže opravu rychlého spuštění TOS."

msgctxt "#30080"
msgid "Whether to Cold Start or Warm Start on \"Restart\"."
msgstr "Určuje, zda se při volbě „Restart“ provede studené, nebo teplé spuštění."

msgctxt "#30081"
msgid "Warm Start"
msgstr "Teplé spuštění"

msgctxt "#30082"
msgid "Cold Start"
msgstr "Studené spuštění"

msgctxt "#30083"
msgid "Set 68000 CPU clock speed. 8 MHz is authentic ST hardware speed. 16 MHz doubles speed for faster loading and gameplay."
msgstr "Nastaví taktovací frekvenci CPU 68000. 8 MHz je autentická rychlost hardwaru ST. 16 MHz zdvojnásobí rychlost pro rychlejší načítání a hraní."

msgctxt "#30084"
msgid "8 MHz (Authentic)"
msgstr "8 MHz (autentická)"

msgctxt "#30085"
msgid "16 MHz (Fast)"
msgstr "16 MHz (rychlá)"

msgctxt "#30086"
msgid "Input"
msgstr "Vstup"

msgctxt "#30087"
msgid "Enable/Disable second joystick, system mouse or system keyboard."
msgstr "Povolí/zakáže druhý joystick, systémovou myš nebo systémovou klávesnici."

msgctxt "#30088"
msgid "Starts with emulated mouse active on port 1.  Otherwise joystick is active on port 1."
msgstr "Spustí se s aktivní emulovanou myší na portu 1. Jinak je na portu 1 aktivní joystick."

msgctxt "#30089"
msgid "Set whether emulated mouse is controlled by left or right analog stick."
msgstr "Určuje, zda je emulovaná myš ovládána levou nebo pravou analogovou páčkou."

msgctxt "#30090"
msgid "Left Analog"
msgstr "Levá analogová páčka"

msgctxt "#30091"
msgid "Right Analog"
msgstr "Pravá analogová páčka"

msgctxt "#30092"
msgid "Set the starting mouse speed from 1 to 6.  Default is 2."
msgstr "Nastaví počáteční rychlost myši od 1 do 6. Výchozí hodnota je 2."

msgctxt "#30093"
msgid "2 (default)"
msgstr "2 (výchozí)"

msgctxt "#30094"
msgid "Enables a second joystick on port 2, may conflict with mouse."
msgstr "Povolí druhý joystick na portu 2, což může být v konfliktu s myší."

msgctxt "#30095"
msgid "Prevents input from your sytem mouse device. Gamepad mouse mode (select) is not disabled."
msgstr "Zabrání vstupu ze zařízení systémové myši. Režim myši gamepadu (Select) není zakázán."

msgctxt "#30096"
msgid "disabled"
msgstr "Zakázáno"

msgctxt "#30097"
msgid "enabled"
msgstr "Povoleno"

msgctxt "#30098"
msgid "Prevents input from your system keyboard. Virtual keyboard is not disabled."
msgstr "Zabrání vstupu ze systémové klávesnice. Virtuální klávesnice se nezakáže."

msgctxt "#30099"
msgid "Video"
msgstr "Video"

msgctxt "#30100"
msgid "Enable/Disable high resolution or overscan cropping.  Set Frameskip."
msgstr "Povolí/zakáže vysoké rozlišení nebo ořez overscanu. Nastaví přeskakování snímků."

msgctxt "#30101"
msgid "Enable Hi-Resolution (832x576). Disable for standard low/medium resolution (352x240)."
msgstr "Povolí vysoké rozlišení (832x576). Pro standardní nízké/střední rozlišení (352x240) zakažte."

msgctxt "#30102"
msgid "Enable for games.  Disable for low/med resolution overscan demos"
msgstr "Povolte pro hry. Zakažte pro dema s overscanem v nízkém/středním rozlišení."

msgctxt "#30103"
msgid "Force refresh rate to Auto, NTSC 60hz or PAL 50hz.  Auto uses selected TOS rate."
msgstr "Vynutí obnovovací frekvenci na Automaticky, NTSC 60 Hz nebo PAL 50 Hz. Automaticky používá frekvenci vybraného TOS."

msgctxt "#30104"
msgid "Auto"
msgstr "Automaticky"

msgctxt "#30105"
msgid "NTSC 60hz"
msgstr "NTSC 60 Hz"

msgctxt "#30106"
msgid "PAL 50hz"
msgstr "PAL 50 Hz"

msgctxt "#30107"
msgid "Disabled, 1-4, Auto (Max 5), Auto (Max 10)."
msgstr "Zakázáno, 1–4, Automaticky (max. 5), Automaticky (max. 10)."

msgctxt "#30108"
msgid "Auto (Max 5)"
msgstr "Automaticky (max. 5)"

msgctxt "#30109"
msgid "Auto (Max 10)"
msgstr "Automaticky (max. 10)"

msgctxt "#30110"
msgid "Where to display Joystick/Mouse toggle and speed change information"
msgstr "Kde zobrazovat informace o přepnutí joysticku/myši a změně rychlosti"

msgctxt "#30111"
msgid "Off"
msgstr "Vypnuto"

msgctxt "#30112"
msgid "Status"
msgstr "Stav"

msgctxt "#30113"
msgid "OSD"
msgstr "OSD"

msgctxt "#30114"
msgid "Enable to show activity in Retroarch status display"
msgstr "Povolí zobrazení aktivity ve stavovém zobrazení RetroArchu."

msgctxt "#30115"
msgid "Media"
msgstr "Média"

msgctxt "#30116"
msgid "Set Fast floppy access and Auto insert drive B."
msgstr "Nastaví rychlý přístup k disketě a automatické vkládání do jednotky B."

msgctxt "#30117"
msgid "Play mechanical floppy drive sounds on disk access. Place floppy.raw (s16le stereo 44100Hz) in RetroArch system dir for custom sound."
msgstr "Přehrávat zvuky mechanické disketové jednotky při přístupu k disku. Vlastní zvuk získáte umístěním souboru floppy.raw (s16le stereo 44100Hz) do systémového adresáře RetroArchu."

msgctxt "#30118"
msgid "Volume of the floppy drive sound effect."
msgstr "Hlasitost zvukového efektu disketové jednotky."

msgctxt "#30119"
msgid "25%"
msgstr "25%"

msgctxt "#30120"
msgid "50%"
msgstr "50%"

msgctxt "#30121"
msgid "75%"
msgstr "75%"

msgctxt "#30122"
msgid "100%"
msgstr "100%"

msgctxt "#30123"
msgid "Decreases the time spent loading from disk."
msgstr "Zkrátí dobu načítání z disku."

msgctxt "#30124"
msgid ""
"Auto inserts disk in Drive B if detected.\n"
"Use only for content that can use two drives.\n"
"M3U loads 2nd entry.  Otherwise looks for \"b\" as last letter before extension."
msgstr ""
"Automaticky vloží detekovaný disk do jednotky B.\n"
"Používejte pouze pro obsah, který může používat dvě jednotky.\n"
"M3U načte druhou položku. Jinak hledá „b“ jako poslední písmeno před příponou."

msgctxt "#30125"
msgid "Enable/Disable write protection for floppy disks."
msgstr "Povolí/zakáže ochranu disket proti zápisu."

msgctxt "#30126"
msgid "On"
msgstr "Zapnuto"

msgctxt "#30127"
msgid "Enable/Disable write protection for hard drives."
