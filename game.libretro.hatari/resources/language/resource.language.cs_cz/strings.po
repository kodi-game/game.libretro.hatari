msgctxt "#30251"
msgid "Unmapped defaults to joystick down."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená joystick dolů."

msgctxt "#30252"
msgid "Unmapped defaults to joystick left."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená joystick doleva."

msgctxt "#30253"
msgid "Unmapped defaults to joystick right."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená joystick doprava."

msgctxt "#30254"
msgid "Unmapped defaults to turbo fire/Mouse button 2."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená tlačítko Turbo Fire/tlačítko myši 2."

msgctxt "#30255"
msgid ""
"Unmapped defaults to fire/mouse button 1.\n"
"VKBD: Press selected key."
msgstr ""
"Nenamapované tlačítko ve výchozím nastavení znamená tlačítko střelby/tlačítko myši 1.\n"
"VKBD: Stiskněte vybranou klávesu."

msgctxt "#30256"
msgid "VKBD: Toggle.  Remapping overrides VKBD toggle."
msgstr "VKBD: Přepnout. Přemapování potlačí přepínání VKBD."

msgctxt "#30257"
msgid "VKBD: Toggle 'ShiftLock'. Remapping overrides VKBD function!"
msgstr "VKBD: Přepnout „ShiftLock“. Přemapování potlačí funkci VKBD!"

msgctxt "#30258"
msgid "Unmapped defaults to Joystick/Mouse mode toggle."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená přepínač režimu joystick/myš."

msgctxt "#30259"
msgid "Unmapped defaults to Enter/Exit the Hatari Settings."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená vstoupit do nastavení Hatari nebo je ukončit."

msgctxt "#30260"
msgid "Unmapped defaults to toggle the Status display."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená přepínač zobrazení stavu."

msgctxt "#30261"
msgid "Unmapped defaults to switch virtual keyboard page."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená přepnutí stránky virtuální klávesnice."

msgctxt "#30262"
msgid "Unmapped defaults to decrease mouse speed."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená snížení rychlosti myši."

msgctxt "#30263"
msgid "Unmapped defaults to increase mouse speed."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená zvýšení rychlosti myši."

msgctxt "#30264"
msgid "Unmapped defaults to space."
msgstr "Nenamapované tlačítko ve výchozím nastavení znamená mezerník."

msgctxt "#30265"
msgid ""
"Mouse mode must be off or on right analog.\n"
"Ignored if assigned to VKBD.\n"
msgstr ""
"Režim myši musí být vypnutý nebo nastavený na pravou analogovou páčku.\n"
"Ignorováno, pokud je přiřazeno k VKBD.\n"

msgctxt "#30266"
msgid "Mouse mode must be off or on left analog."
msgstr "Režim myši musí být vypnutý nebo nastavený na levou analogovou páčku."

